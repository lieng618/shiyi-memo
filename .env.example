# 拾忆 Docker 部署配置模板:复制为 .env 后按需修改(docker compose 会自动读取)
# 公网部署务必修改:MYSQL_PASSWORD、APP_JWT_SECRET、APP_ADMIN_PASSWORD、邮件配置

# 对外端口
APP_PORT=8080

# 数据库密码(compose 内建 MySQL)
MYSQL_PASSWORD=shiyi-memo
MYSQL_ROOT_PASSWORD=shiyi-memo-root

# 登录令牌密钥,至少 32 字节,用随机长字符串
APP_JWT_SECRET=dev-only-secret-please-change-me-0123456789
# 挂上 HTTPS 后改为 true
APP_JWT_SECURE_COOKIE=false

# 后台控制台(/admin)账号
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# 站点对外地址,邮件正文里的链接会用它
APP_BASE_URL=http://localhost:8080

# 是否允许新邮箱自助注册
APP_SECURITY_ALLOW_REGISTER=true

# 邮件验证码:默认不真实发信、验证码由登录接口直接返回,仅限内网体验
# 公网部署:APP_MAIL_ENABLED=true、APP_MAIL_EXPOSE_CODE=false,并填好 SMTP 账号与授权码
APP_MAIL_ENABLED=false
APP_MAIL_EXPOSE_CODE=true
APP_MAIL_FROM=
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
